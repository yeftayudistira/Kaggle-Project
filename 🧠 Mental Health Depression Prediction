ction']] = (\n","        df[['Work Pressure', 'Job Satisfaction']].fillna(0)\n","    )\n","    return df\n","\n","train_proc = preprocess(train)\n","test_proc  = preprocess(test)\n","\n","print(f\"Train processed : {train_proc.shape}\")\n","print(f\"Test processed  : {test_proc.shape}\")\n","train_proc[FEATURES].describe().round(2)"]},{"cell_type":"code","execution_count":9,"id":"b41ac9d2","metadata":{"execution":{"iopub.execute_input":"2026-04-02T03:13:14.035735Z","iopub.status.busy":"2026-04-02T03:13:14.03461Z","iopub.status.idle":"2026-04-02T03:13:16.412674Z","shell.execute_reply":"2026-04-02T03:13:16.41133Z"},"papermill":{"duration":2.393764,"end_time":"2026-04-02T03:13:16.415849","exception":false,"start_time":"2026-04-02T03:13:14.022085","status":"completed"},"tags":[]},"outputs":[{"data":{"image/png":"","text/plain":["<Figure size 1600x1100 with 12 Axes>"]},"metadata":{},"output_type":"display_data"}],"source":["# ── Feature distributions (test set) ─────────────────────────────────────\n","fig, axes = plt.subplots(3, 4, figsize=(16, 11))\n","axes = axes.flatten()\n","\n","for i, col in enumerate(FEATURES):\n","    test_proc[col].plot.hist(ax=axes[i], bins=20, color='#8da0cb', edgecolor='white')\n","    axes[i].set_title(col, fontsize=9, fontweight='bold')\n","    axes[i].set_xlabel('')\n","\n","for j in range(len(FEATURES), len(axes)):\n","    axes[j].set_visible(False)\n","\n","plt.suptitle('Feature Distributions (Test Set)', fontsize=13, fontweight='bold', y=1.01)\n","plt.tight_layout()\n","plt.show()"]},{"cell_type":"markdown","id":"3ba4c47e","metadata":{"papermill":{"duration":0.013493,"end_time":"2026-04-02T03:13:16.443835","exception":false,"start_time":"2026-04-02T03:13:16.430342","status":"completed"},"tags":[]},"source":["## 5. Model Training & Evaluation\n","\n","> **Why validation split, not test set?**  \n","> `test.csv` contains no `Depression` labels — it is the unlabelled competition submission file.  \n","> We split `train.csv` 80/20 (stratif
umpy().astype(int)\n    for box, score, lbl in zip(boxes, scores, labels):\n        x1, y1, x2, y2 = box\n        color = COLORS(lbl / NUM_CLASSES)\n        ax.add_patch(patches.Rectangle(\n            (x1, y1), x2-x1, y2-y1,\n            linewidth=1.5, edgecolor=color,\n            facecolor='none', linestyle='--'\n        ))\n        ax.text(x1, y1-4, f\"{class_names[lbl]} {score:.2f}\",\n                fontsize=6, color='white',\n                bbox=dict(facecolor=color, alpha=0.75, pad=1, edgecolor='none'))\n    return len(boxes)\n\nTEST_LABEL_DIR = TEST_IMG_DIR.parent / 'labels'\n\ntest_imgs   = sorted(TEST_IMG_DIR.glob('*.jpg'))\nsample_imgs = random.sample(test_imgs, min(6, len(test_imgs)))\n\npred_results = model_best.predict(\n    source=sample_imgs,\n    imgsz=640,\n    conf=0.25,\n    iou=0.5,\n    device=0,\n    verbose=False,\n)\n\n# ── Plot ──────────────────────────────────────────────────────────────────────\nn = len(pred_results)\nfig, axes = plt.subplots(n, 2, figsize=(16, n * 5))\nif n == 1:\n    axes = [axes]\n\nfor row, (result, img_path) in enumerate(zip(pred_results, sample_imgs)):\n    img_path  = Path(img_path)\n    lbl_path  = TEST_LABEL_DIR / (img_path.stem + '.txt')  \n    img_rgb   = result.orig_img[:, :, ::-1]\n\n    # GT\n    ax_gt = axes[row][0]\n    ax_gt.imshow(img_rgb)\n    plot_gt_boxes(img_rgb, lbl_path, CLASS_NAMES, ax_gt)\n    ax_gt.set_title(f\"[GT] {img_path.name}\", fontsize=7)  \n    ax_gt.axis('off')\n\n    # Pred\n    ax_pr = axes[row][1]\n    ax_pr.imshow(img_rgb)\n    n_det = plot_pred_boxes(result, CLASS_NAMES, ax_pr)\n    ax_pr.set_title(f\"[PRED] {img_path.name} | {n_det} detections\", fontsize=7)\n    ax_pr.axis('off')\n\nfig.text(0.5, 0.002,\n         'Solid = Ground Truth     Dashed = Prediksi',\n         ha='center', fontsize=9, color='gray', style='italic')\n\nplt.suptitle('Ground Truth vs YOLO11m Predictions - WaRP-D Test Set',\n             fontsize=13, fontweight='bold')\nplt.tight_layout()\nplt.savefig(OUT
Warp-D'\nCLASSES_PATH  = WARPD / 'classes.txt'\n\nTRAIN_IMG_DIR = WARPD / 'train' / 'images'\nTRAIN_LBL_DIR = WARPD / 'train' / 'labels'\nTEST_IMG_DIR  = WARPD / 'test'  / 'images'\nTEST_LBL_DIR  = WARPD / 'test'  / 'labels'\n\n# ─── OUTPUT PATHS (writable) ──────────────────────────────────────────────────\nWORK_DIR   = Path('/kaggle/working')\nOUTPUT_DIR = WORK_DIR / 'outputs'\nOUTPUT_DIR.mkdir(parents=True, exist_ok=True)\n\n# data.yaml will be generated here\nYAML_PATH = WORK_DIR / 'warp_d.yaml'\n\n# Verify input dirs\nfor p in [TRAIN_IMG_DIR, TRAIN_LBL_DIR, TEST_IMG_DIR, TEST_LBL_DIR]:\n    count = len(list(p.glob('*')))\n    status = '✓' if count > 0 else '✗ EMPTY'\n    print(f\"{status}  {str(p.relative_to(ROOT)):50s} → {count:5d} files\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-06T04:28:20.913845Z","iopub.execute_input":"2026-04-06T04:28:20.914226Z","iopub.status.idle":"2026-04-06T04:28:21.680368Z","shell.execute_reply.started":"2026-04-06T04:28:20.914199Z","shell.execute_reply":"2026-04-06T04:28:21.679575Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 3. Generate data.yaml\n\nUltralytics membutuhkan `data.yaml`. Kita generate dari `classes.txt` yang ada.","metadata":{}},{"cell_type":"code","source":"# Read class names from classes.txt\nwith open(CLASSES_PATH, 'r') as f:\n    CLASS_NAMES = [line.strip() for line in f if line.strip()]\n\nNUM_CLASSES = len(CLASS_NAMES)\nprint(f\"Number of classes : {NUM_CLASSES}\")\nfor i, name in enumerate(CLASS_NAMES):\n    print(f\"  [{i:2d}] {name}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-06T04:28:21.681302Z","iopub.execute_input":"2026-04-06T04:28:21.681607Z","iopub.status.idle":"2026-04-06T04:28:21.691677Z","shell.execute_reply.started":"2026-04-06T04:28:21.68158Z","shell.execute_reply":"2026-04-06T04:28:21.69086Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# Generate data.yaml — Ultralytics format\n# Note: path must be absolute for Ultralytics to find the dataset\nyaml_content = f\"\"\"path: {str(WARPD)}  # dataset root\ntrain: train/images\nval: test/images\ntest: test/images\n\nnc: {NUM_CLASSES}\nnames: {CLASS_NAMES}\n\"\"\"\n\nwith open(YAML_PATH, 'w') as f:\n    f.write(yaml_content)\n\nprint(f\"data.yaml generated at: {YAML_PATH}\")\nprint()\nprint(yaml_content)","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-06T04:28:21.692765Z","iopub.execute_input":"2026-04-06T04:28:21.693162Z","iopub.status.idle":"2026-04-06T04:28:21.702175Z","shell.execute_reply.started":"2026-04-06T04:28:21.693121Z","shell.execute_reply":"2026-04-06T04:28:21.701619Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 4. Data Exploration","metadata":{}},{"cell_type":"code","source":"# ── Class distribution (train set) ──────────────────────────────────────────\ncls_counts = defaultdict(int)\nfor lbl_path in TRAIN_LBL_DIR.glob('*.txt'):\n    with open(lbl_path) as f:\n        for line in f:\n            line = line.strip()\n            if line:\n                cls_id = int(line.split()[0])\n                cls_counts[cls_id] += 1\n\nsorted_counts = sorted(cls_counts.items(), key=lambda x: x[1], reverse=True)\nnames  = [CLASS_NAMES[i] for i, _ in sorted_counts]\ncounts = [c for _, c in sorted_counts]\n\nfig, ax = plt.subplots(figsize=(14, 5))\nbars = ax.bar(range(len(names)), counts, color='steelblue', edgecolor='white')\nax.set_xticks(range(len(names)))\nax.set_xticklabels(names, rotation=60, ha='right', fontsize=8)\nax.set_ylabel('Number of instances')\nax.set_title('WaRP-D Train Set — Class Distribution')\nax.bar_label(bars, fontsize=6, padding=2)\nplt.tight_layout()\nplt.savefig(OUTPUT_DIR / 'class_distribution.png', dpi=150)\nplt.show()\nprint(f\"Total train instances: {sum(counts):,}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-06T04:28:21.703072Z","iopub.execute_input":"2026-04-06T04:28:21.703348Z","iopub.status.idle":"2026-04-06T04:28:37.041426Z","shell.execute_reply.started":"2026-04-06T04:28:21.703324Z","shell.execute_reply":"2026-04-06T04:28:37.040697Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── Visualize sample images ──────────────────────────────────────────────────\nCOLORS = plt.cm.get_cmap('tab20', NUM_CLASSES)\n\ndef plot_yolo_sample(img_path, lbl_path, class_names, ax):\n    img    = np.array(Image.open(img_path).convert('RGB'))\n    h, w   = img.shape[:2]\n    ax.imshow(img)\n\n    if lbl_path.exists():\n        with open(lbl_path) as f:\n            for line in f:\n                parts  = line.strip().split()\n                if not parts: continue\n                cls_id = int(parts[0])\n                cx, cy, bw, bh = map(float, parts[1:5])\n                x1 = (cx - bw/2) * w\n                y1 = (cy - bh/2) * h\n                x2 = (cx + bw/2) * w\n                y2 = (cy + bh/2) * h\n                color = COLORS(cls_id)\n                rect  = patches.Rectangle(\n                    (x1, y1), x2-x1, y2-y1,\n                    linewidth=1.5, edgecolor=color, facecolor='none'\n                )\n                ax.add_patch(rect)\n                ax.text(\n                    x1, y1-4, class_names[cls_id],\n                    fontsize=6, color='white',\n                    bbox=dict(facecolor=color, alpha=0.75, pad=1, edgecolor='none')\n                )\n    ax.axis('off')\n\n\nimg_paths = sorted(TRAIN_IMG_DIR.glob('*.jpg'))\nsample    = random.sample(img_paths, min(6, len(img_paths)))\n\nfig, axes = plt.subplots(2, 3, figsize=(16, 10))\nfor ax, img_path in zip(axes.flat, sample):\n    lbl_path = TRAIN_LBL_DIR / (img_path.stem + '.txt')\n    plot_yolo_sample(img_path, lbl_path, CLASS_NAMES, ax)\n    ax.set_title(img_path.name, fontsize=7)\n\nplt.suptitle('WaRP-D Training Samples (Ground Truth)', fontsize=12)\nplt.tight_layout()\nplt.savefig(OUTPUT_DIR / 'sample_images.png', dpi=150, bbox_inches='tight')\nplt.show()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-06T04:28:37.042429Z","iopub.execute_input":"2026-04-06T04:28:37.043068Z","iopub.status.idle":"2026-04-06T04:28:40.121928Z","shell.execute_reply.started":"2026-04-06T04:28:37.04304Z","shell.execute_reply":"2026-04-06T04:28:40.120927Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 5. Training Config\n\nYOLO11m dengan pretrained COCO weights, fine-tuned pada WaRP-D.","metadata":{}},{"cell_type":"code","source":"\nTRAIN_CFG = dict(\n    # ── Core ──\n    data        = str(YAML_PATH),\n    epochs      = 60,\n    imgsz       = 640,\n    batch       = 8,           # T4 16GB: batch 8 aman untuk YOLO11l 640px\n    device      = 0,           # GPU index\n\n    # ── Optimizer ──\n    optimizer   = 'AdamW',\n    lr0         = 1e-3,        # initial LR\n    lrf         = 1e-2,        # final LR = lr0 * lrf\n    momentum    = 0.937,\n    weight_decay= 5e-4,\n    warmup_epochs    = 3,\n    warmup_momentum  = 0.8,\n\n    # ── Augmentation ──\n    # Sesuai paper: mosaic, mixup, HSV, flip, rotate\n    mosaic      = 1.0,         # mosaic augmentation (paper: key untuk WaRP)\n    mixup       = 0.5,         # mixup probability\n    hsv_h       = 0.015,       # HSV hue\n    hsv_s       = 0.7,         # HSV saturation\n    hsv_v       = 0.4,         # HSV value\n    flipud      = 0.2,         # vertical flip (paper: 20%)\n    fliplr      = 0.5,         # horizontal flip\n    degrees     = 90.0,        # rotation (paper: 90 degrees)\n    scale       = 0.2,         # scale jitter\n    translate   = 0.2,         # translate jitter\n\n    # ── Loss weights ──\n    box         = 7.5,\n    cls         = 0.5,\n    dfl         = 1.5,\n\n    # ── Output & misc ──\n    project     = str(OUTPUT_DIR),\n    name        = 'yolo11m_warpd',\n    exist_ok    = True,\n    pretrained  = True,        # start from COCO pretrained\n    seed        = SEED,\n    workers     = 2,\n    val         = True,        # validate every epoch\n    save        = True,\n    save_period = 10,          # save checkpoint every 10 epochs\n    plots       = True,        # auto-generate training plots\n    verbose     = True,\n)\n\nprint(\"Training config:\")\nfor k, v in TRAIN_CFG.items():\n    print(f\"  {k:20s}: {v}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-06T04:39:51.819353Z","iopub.execute_input":"2026-04-06T04:39:51.820594Z","iopub.status.idle":"2026-04-06T04:39:51.828063Z","shell.execute_reply.started":"2026-04-06T04:39:51.820553Z","shell.execute_reply":"2026-04-06T04:39:51.827346Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 6. Load Model & Train","metadata":{}},{"cell_type":"code","source":"# Load YOLO11m dengan pretrained COCO weights\nmodel = YOLO('yolo11m.pt')\n\nprint(f\"Model   : {model.info()}\")\nprint(f\"\\nStarting training...\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-06T04:39:51.829256Z","iopub.execute_input":"2026-04-06T04:39:51.829596Z","iopub.status.idle":"2026-04-06T04:39:52.148848Z","shell.execute_reply.started":"2026-04-06T04:39:51.82957Z","shell.execute_reply":"2026-04-06T04:39:52.14806Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ─── TRAIN ───────────────────────────────────────────────────────────────────\nresults = model.train(**TRAIN_CFG)\n\nprint(\"\\nTraining complete!\")\nprint(f\"Best model saved at: {results.save_dir}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-06T04:39:52.149936Z","iopub.execute_input":"2026-04-06T04:39:52.150289Z","iopub.status.idle":"2026-04-06T06:53:33.2991Z","shell.execute_reply.started":"2026-04-06T04:39:52.150251Z","shell.execute_reply":"2026-04-06T06:53:33.298272Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 7. Evaluation","metadata":{}},{"cell_type":"code","source":"# Load best model\nbest_model_path = Path(results.save_dir) / 'weights' / 'best.pt'\nmodel_best = YOLO(str(best_model_path))\n\n# Run validation on test set\nval_results = model_best.val(\n    data=str(YAML_PATH),\n    split='test',\n    imgsz=640,\n    batch=8,\n    device=0,\n    verbose=True,\n)\n\nmap50    = val_results.box.map50\nmap50_95 = val_results.box.map\n\nprint(f\"\\n{'='*40}\")\nprint(f\"  mAP@50     : {map50*100:.2f}%\")\nprint(f\"  mAP@50:95  : {map50_95*100:.2f}%\")\nprint(f\"{'='*40}\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-06T06:53:33.301314Z","iopub.execute_input":"2026-04-06T06:53:33.301752Z","iopub.status.idle":"2026-04-06T06:53:46.259847Z","shell.execute_reply.started":"2026-04-06T06:53:33.301718Z","shell.execute_reply":"2026-04-06T06:53:46.258945Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"# ── Per-class AP50 ──────────────────────────────────────────────────────────\nper_class_ap50 = {}\nif hasattr(val_results.box, 'ap_class_index'):\n    for idx, cls_id in enumerate(val_results.box.ap_class_index):\n        name = CLASS_NAMES[cls_id]\n        ap50 = float(val_results.box.ap50[idx]) * 100\n        per_class_ap50[name] = ap50\n\n# Sort and plot\nsorted_ap = dict(sorted(per_class_ap50.items(), key=lambda x: x[1], reverse=True))\n\nfig, ax = plt.subplots(figsize=(14, 6))\ncolors = ['#2ecc71' if v >= 50 else '#e74c3c' for v in sorted_ap.values()]\nbars = ax.bar(range(len(sorted_ap)), list(sorted_ap.values()), color=colors, edgecolor='white')\nmean_ap = np.mean(list(sorted_ap.values()))\nax.axhline(mean_ap, color='navy', linestyle='--', label=f'Mean: {mean_ap:.1f}%')\nax.set_xticks(range(len(sorted_ap)))\nax.set_xticklabels(list(sorted_ap.keys()), rotation=60, ha='right', fontsize=8)\nax.set_ylabel('AP50 (%)')\nax.set_ylim(0, 110)\nax.set_title('Per-class AP50 — YOLO11m on WaRP-D')\nax.legend()\nax.bar_label(bars, fmt='%.1f', fontsize=6, padding=2)\nplt.tight_layout()\nplt.savefig(OUTPUT_DIR / 'per_class_ap50.png', dpi=150, bbox_inches='tight')\nplt.show()\n\n# Print table\nprint(f\"\\n{'Class':<30} {'AP50 (%)':>10}\")\nprint('-' * 42)\nfor name, ap in sorted_ap.items():\n    print(f\"{name:<30} {ap:>10.2f}\")\n\n# Compare with paper (YOLOX-m baseline)\nprint(f\"\\nComparison with paper (YOLOX-m):\")\nprint(f\"  Paper mAP50  : 58.6%\")\nprint(f\"  Our  mAP50   : {map50*100:.2f}%\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-06T06:53:46.261212Z","iopub.execute_input":"2026-04-06T06:53:46.261595Z","iopub.status.idle":"2026-04-06T06:53:47.184272Z","shell.execute_reply.started":"2026-04-06T06:53:46.261563Z","shell.execute_reply":"2026-04-06T06:53:47.183574Z"}},"outputs":[],"execution_count":null},{"cell_type":"markdown","source":"## 8. Training Curves\n\nUltralytics auto-generate training plots. Kita load dan tampilkan.","metadata":{}},{"cell_type":"code","source":"save_dir   = Path(results.save_dir)\ncsv_path   = save_dir / 'results.csv'\n\ndf = pd.read_csv(csv_path)\ndf.columns = df.columns.str.strip()  # remove whitespace from column names\nprint(\"Columns:\", df.columns.tolist())\ndf.head()","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-06T06:53:47.185417Z","iopub.execute_input":"2026-04-06T06:53:47.185768Z","iopub.status.idle":"2026-04-06T06:53:47.244717Z","shell.execute_reply.started":"2026-04-06T06:53:47.185741Z","shell.execute_reply":"2026-04-06T06:53:47.243974Z"}},"outputs":[],"execution_count":null},{"cell_type":"code","source":"fig, axes = plt.subplots(2, 3, figsize=(18, 10))\n\n# Helper to find column by partial name\ndef get_col(df, keyword):\n    matches = [c for c in df.columns if keyword.lower() in c.lower()]\n    return df[matches[0]] if matches else None\n\nepochs = df['epoch'] if 'epoch' in df.columns else range(len(df))\n\n# ── Box loss ──\ntrain_box = get_col(df, 'train/box')\nval_box   = get_col(df, 'val/box')\nif train_box is not None:\n    axes[0,0].plot(epochs, train_box, label='Train')\nif val_box is not None:\n    axes[0,0].plot(epochs, val_box, label='Val')\naxes[0,0].set_title('Box Loss')\naxes[0,0].set_xlabel('Epoch')\naxes[0,0].legend()\naxes[0,0].grid(alpha=0.3)\n\n# ── Cls loss ──\ntrain_cls = get_col(df, 'train/cls')\nval_cls   = get_col(df, 'val/cls')\nif train_cls is not None:\n    axes[0,1].plot(epochs, train_cls, label='Train')\nif val_cls is not None:\n    axes[0,1].plot(epochs, val_cls, label='Val')\naxes[0,1].set_title('Class Loss')\naxes[0,1].set_xlabel('Epoch')\naxes[0,1].legend()\naxes[0,1].grid(alpha=0.3)\n\n# ── DFL loss ──\ntrain_dfl = get_col(df, 'train/dfl')\nval_dfl   = get_col(df, 'val/dfl')\nif train_dfl is not None:\n    axes[0,2].plot(epochs, train_dfl, label='Train')\nif val_dfl is not None:\n    axes[0,2].plot(epochs, val_dfl, label='Val')\naxes[0,2].set_title('DFL Loss')\naxes[0,2].set_xlabel('Epoch')\naxes[0,2].legend()\naxes[0,2].grid(alpha=0.3)\n\n# ── mAP50 ──\nmap50_col = get_col(df, 'metrics/mAP50(B)')\nif map50_col is not None:\n    axes[1,0].plot(epochs, map50_col * 100, color='green')\naxes[1,0].set_title('mAP@50')\naxes[1,0].set_xlabel('Epoch')\naxes[1,0].set_ylabel('%')\naxes[1,0].grid(alpha=0.3)\n\n# ── mAP50-95 ──\nmap5095_col = get_col(df, 'metrics/mAP50-95(B)')\nif map5095_col is not None:\n    axes[1,1].plot(epochs, map5095_col * 100, color='orange')\naxes[1,1].set_title('mAP@50:95')\naxes[1,1].set_xlabel('Epoch')\naxes[1,1].set_ylabel('%')\naxes[1,1].grid(alpha=0.3)\n\n# ── Precision & Recall ──\nprec = get_col(df, 'metrics/precision')\nrec  = get_col(df, 'metrics/recall')\nif prec is not None:\n    axes[1,2].plot(epochs, prec * 100, label='Precision')\nif rec is not None:\n    axes[1,2].plot(epochs, rec * 100, label='Recall')\naxes[1,2].set_title('Precision & Recall')\naxes[1,2].set_xlabel('Epoch')\naxes[1,2].set_ylabel('%')\naxes[1,2].legend()\naxes[1,2].grid(alpha=0.3)\n\nplt.suptitle('YOLO11m Training on WaRP-D', fontsize=14)\nplt.tight_layout()\nplt.savefig(OUTPUT_DIR / 'training_curves.png', dpi=150, bbox_inches='tight')\nplt.show()","metadata":{"trusted":true,"execu
cecolor=color, alpha=0.75, pad=1, edgecolor='none'))\n    else:\n        ax.set_xlabel('Label not found', color='red')\n\n\ndef predict_dfine(model, processor, img_path, conf=0.25, device=DEVICE):\n    \"\"\"Run D-FINE inference on a single image.\"\"\"\n    image   = Image.open(img_path).convert('RGB')\n    w, h    = image.size\n    inputs  = processor(images=image, return_tensors=\"pt\").to(device)\n    with torch.no_grad():\n        outputs = model(**inputs)\n    results = processor.post_process_object_detection(\n        outputs, target_sizes=[(h, w)], threshold=conf\n    )[0]\n    return results, np.array(image)\n\n\ndef plot_pred_boxes_dfine(results, class_names, ax):\n    \"\"\"Draw D-FINE predictions on axis.\"\"\"\n    n_det = len(results['scores'])\n    for score, label_id, box in zip(results['scores'], results['labels'], results['boxes']):\n        score = score.item()\n        lbl   = label_id.item()\n        x1, y1, x2, y2 = [round(v, 1) for v in box.tolist()]\n        color = COLORS(lbl / NUM_CLASSES)\n        ax.add_patch(patches.Rectangle(\n            (x1, y1), x2 - x1, y2 - y1,\n            linewidth=1.5, edgecolor=color, facecolor='none', linestyle='--'\n        ))\n        ax.text(x1, y1 - 4, f\"{class_names[lbl]} {score:.2f}\",\n                fontsize=6, color='white',\n                bbox=dict(facecolor=color, alpha=0.75, pad=1, edgecolor='none'))\n    return n_det\n\n\n# ── Run on random test images ─────────────────────────────────────────────────\ntest_imgs_all = sorted(TEST_IMG_DIR.glob('*.jpg'))\nsample_imgs   = random.sample(test_imgs_all, min(6, len(test_imgs_all)))\n\nn = len(sample_imgs)\nfig, axes = plt.subplots(n, 2, figsize=(16, n * 5))\nif n == 1:\n    axes = [axes]\n\nfor row, img_path in enumerate(sample_imgs):\n    img_path = Path(img_path)\n    lbl_path = TEST_LBL_DIR / (img_path.stem + '.txt')\n    results, img_rgb = predict_dfine(model_best, proc_best, img_path, conf=CONF_THRESH)\n\n    # Ground Truth\n    ax_gt = axes[row
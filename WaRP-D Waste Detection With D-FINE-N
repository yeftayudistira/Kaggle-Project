box2[2] - box2[0]) * (box2[3] - box2[1])\n    union = a1 + a2 - inter\n    return inter / union if union > 0 else 0.0\n\ndef calculate_ap(recalls, precisions):\n    \"\"\" Compute the average precision using all-point interpolation (standard COCO/Pascal). \"\"\"\n    mrec = np.concatenate(([0.0], recalls, [1.0]))\n    mpre = np.concatenate(([1.0], precisions, [0.0]))\n\n    # Compute the precision envelope (monotonically decreasing)\n    for i in range(mpre.size - 1, 0, -1):\n        mpre[i - 1] = np.maximum(mpre[i - 1], mpre[i])\n\n    # Find points where recall changes\n    i = np.where(mrec[1:] != mrec[:-1])[0]\n\n    # Sum of Area under PR curve\n    ap = np.sum((mrec[i + 1] - mrec[i]) * mpre[i + 1])\n    return ap\n\ndef run_full_evaluation(model, processor, img_dir, lbl_dir, \n                        conf_thresh=0.001, iou_thresh=0.5, device=\"cuda\"):\n    \n    img_paths = sorted(Path(img_dir).glob('*.jpg'))\n    all_predictions = []  # format: [score, is_tp, class_id]\n    class_gt_counts = Counter()\n    \n    print(f\"Memproses {len(img_paths)} gambar...\")\n\n    for img_path in tqdm.tqdm(img_paths):\n        image = Image.open(img_path).convert('RGB')\n        w, h = image.size\n        \n        # 1. Load Ground Truth\n        gt_boxes, gt_labels = [], []\n        lbl_path = Path(lbl_dir) / (img_path.stem + '.txt')\n        if lbl_path.exists():\n            with open(lbl_path) as f:\n                for line in f:\n                    parts = line.strip().split()\n                    if len(parts) < 5: continue\n                    cls_id = int(float(parts[0]))\n                    cx, cy, bw, bh = map(float, parts[1:5])\n                    gt_boxes.append([(cx-bw/2)*w, (cy-bh/2)*h, (cx+bw/2)*w, (cy+bh/2)*h])\n                    gt_labels.append(cls_id)\n                    class_gt_counts[cls_id] += 1\n\n        # 2. Model Prediction\n        inputs = processor(images=image, return_tensors=\"pt\").to(device)\n        with torch.no_grad():\n            outputs = model(**inputs)\n        \n        # Post-process (Gunakan conf_thresh rendah untuk mAP yang lebih akurat)\n        results = processor.post_process_object_detection(outputs, target_sizes=[(h, w)], threshold=conf_thresh)[0]\n\n        p_boxes = results['boxes'].cpu().numpy()\n        p_scores = results['scores'].cpu().numpy()\n        p_labels = results['labels'].cpu().numpy()\n\n        # 3. Matching Prediksi ke GT per gambar\n        matched_gt = set()\n        # Urutkan berdasarkan skor tertinggi (penting untuk mAP)\n        indices = np.argsort(-p_scores)\n        \n        for i in indices:\n            pb, ps, pl = p_boxes[i], p_scores[i], p_labels[i]\n            best_iou, best_j = 0, -1\n            \n            for j, (gb, gl) in enumerate(zip(gt_boxes, gt_labels)):\n                if j in matched_gt or gl != pl:\n                    continue\n                iou = box_iou(pb, gb)\n                if iou > best_iou:\n                    best_iou, best_j = iou, j\n            \n            if best_iou >= iou_thresh:\n                all_predictions.append([ps, 1, pl]) # True Positive\n                matched_gt.add(best_j)\n            else:\n                all_predictions.append([ps, 0, pl]) # False Positive\n\n    # 4. Kalkulasi AP per Kelas\n    all_predictions = np.array(all_predictions)\n    aps = {}\n    \n    print(\"\\n\" + \"=\"*40)\n    print(f\"{'Class ID':<10} | {'AP':<10} | {'GT Count':<10}\")\n    print(\"-\" * 40)\n\n    # Kita loop semua kelas yang ada di Ground Truth\n    for c in sorted(class_gt_counts.keys()):\n        cls_preds = all_predictions[all_predictions[:, 2] == c]\n        \n        if len(cls_preds) == 0:\n            ap = 0.0\n        else:\n            # Sort by confidence score\n            cls_preds = cls_preds[np.argsort(-cls_preds[:, 0])]\n            \n            tps = np.cumsum(cls_preds[:, 1])\n            fps = np.cumsum(1 - cls_preds[:, 1])\n            \n            recalls = tps / class_gt_counts[c